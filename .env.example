# ============================================
# Grandma's Ladle — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Backend (services/api) ---
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/grandmas_ladle

# JWT
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-string
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
BUSINESS_EMAIL=grandmasladle1269@gmail.com

# WhatsApp
WHATSAPP_BUSINESS_NUMBER=9841207516

# Google Maps
GOOGLE_MAPS_API_KEY=

# Object Storage (for media uploads — configure when ready)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Frontend (apps/web) ---
# Only VITE_ prefixed vars are exposed to browser code
VITE_APP_NAME=Grandma's Ladle
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_ENV=development
VITE_WHATSAPP_NUMBER=919841207516

# --- Frontend (apps/admin) ---
VITE_ADMIN_API_BASE_URL=http://localhost:5000/api/v1
