# Backend Environment Variables
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grandmas_ladle
JWT_ACCESS_SECRET=super_secret_access_key_replace_me_in_production_min_32_chars_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_replace_me_in_production_min_32_chars_67890
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Email / Contact Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
BUSINESS_EMAIL=contact@grandmasladle.com
WHATSAPP_BUSINESS_NUMBER=+919876543210
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
