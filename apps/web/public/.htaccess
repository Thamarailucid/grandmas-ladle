# ----------------------------------------------------------------------
# Proper MIME types for modern ES Modules and Web Assets
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
</IfModule>

# ----------------------------------------------------------------------
# SPA Routing & Fallback Protection
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # CRITICAL: If an asset in /assets/ is requested and does NOT exist,
  # return 404 immediately. NEVER rewrite missing JS/CSS/asset requests
  # to index.html (which causes "MIME type text/html" script errors).
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteRule ^ - [R=404,L]

  # Return 404 for missing static extensions as well
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot)$ [NC]
  RewriteRule ^ - [R=404,L]

  # All other routes (e.g. /sale, /menu, /festivals) serve index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Cache-Control Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # NEVER cache index.html so users always get current module references immediately
  <Files "index.html">
    Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # Cache static hashed assets aggressively (Vite hashes file names)
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|webp|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
